{
  "name": "multiplayer-games",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev --config backend/wrangler.jsonc",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "check:deploy": "wrangler deploy --dry-run --config backend/wrangler.jsonc",
    "dev:manual": "wrangler dev --local --ip 127.0.0.1 --port 8788 --persist-to .wrangler/manual --config tests/manual/wrangler.jsonc",
    "build": "node scripts/build-frontend.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.2-beta",
    "wrangler": "^4.152.0"
  }
}
